{
  "sources": {
    "budget-speech": {
      "title": "Budget Speech 2025-26, Annexure to Part-B, para 2 (Rebate on income-tax), printed page 47 (PDF page 51)",
      "url": "https://www.indiabudget.gov.in/doc/bspeech/bs2025_26.pdf",
      "note": "The Finance Minister's own table of new-regime tax at sample incomes. 'Income' in that table is total income, so the cases pass it as otherIncome (no standard deduction). Its 'Proposed' column is slab tax, 'Rebate benefit' is the s.87A rebate, and 'Tax after rebate' is tax before surcharge and cess."
    },
    "statute": {
      "title": "Hand computation from the Finance Act 2025 First Schedule, s.87A, s.111A, s.112A, s.288A and s.288B",
      "url": "https://www.indiabudget.gov.in/budget2025-26/doc/memo.pdf",
      "note": "Worked by hand from the rates and provisos, with the arithmetic in the Working column. These are not independent of the author the way the Budget Speech rows are: they check that the engine does what the statute says, not that a second party agrees."
    }
  },
  "cases": [
    {
      "id": "bs-8l",
      "source": "budget-speech",
      "label": "8 lakh total income, new regime",
      "tool": "compute_tax",
      "args": { "regime": "new", "otherIncome": 800000 },
      "expect": {
        "slabTax": 20000,
        "rebate87A": 20000,
        "taxBeforeSurcharge": 0
      }
    },
    {
