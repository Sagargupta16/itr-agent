{
  // Typecheck config for the test suite. Kept separate from tsconfig.json
  // because that one carries the build's rootDir/outDir/declaration settings,
  // which reject files outside src/. Without this, tests were never typechecked
  // and a stale assertion or wrong call signature only showed up at runtime.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false
  },
  "include": ["src", "tests"],
  "exclude": ["dist", "node_modules"]
}
