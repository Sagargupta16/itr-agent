{
  "name": "itr-agent",
  "version": "0.5.5",
  "description": "Local-first MCP filing agent for Indian income tax: pick your ITR form, compute tax, reconcile 26AS/AIS, and walk the filing checklist -- entirely on your machine",
  "keywords": [
    "mcp",
    "mcp-server",
    "india",
    "income-tax",
    "itr",
    "form-26as",
    "tax-calculator",
    "claude",
    "agent"
  ],
  "license": "MIT",
  "author": "Sagar Gupta <sg85207@gmail.com> (https://github.com/Sagargupta16)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sagargupta16/itr-agent.git"
  },
  "mcpName": "io.github.sagargupta16/itr-agent",
  "type": "module",
  "bin": {
    "itr-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "validate": "node scripts/validate.mjs",
    "bundle": "node scripts/build-mcpb.mjs",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
